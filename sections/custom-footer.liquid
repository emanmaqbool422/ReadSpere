{{ 'custom-footer.css' | asset_url | stylesheet_tag }}

<footer
  class="footer-custom"
  {% if section.settings.bg_image != blank %}
    style="background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');"
  {% endif %}
>

  <div class="page-width">

    <div class="footer-grid">

      <!-- About -->
      <div class="footer-about">

        {% if section.settings.footer_logo != blank %}
          <img
            src="{{ section.settings.footer_logo | image_url: width: 180 }}"
            alt="{{ shop.name }}"
            class="footer-logo"
          />
        {% endif %}

        <h3 class="footer-title">
          {{ section.settings.footer_heading }}
        </h3>

        <p class="footer-description">
          {{ section.settings.footer_description }}
        </p>

      </div>

      <!-- Quick Links -->

      <div class="footer-links">

        <h3 class="footer-title">
          Your Account
        </h3>

        {% if linklists[section.settings.quick_links] != blank %}
          <ul class="footer-menu">

            {% for link in linklists[section.settings.quick_links].links %}

              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>

            {% endfor %}

          </ul>
        {% endif %}

      </div>

      <!-- Company -->

      <div class="footer-links">

        <h3 class="footer-title">
          Our Company
        </h3>

        {% if linklists[section.settings.company_links] != blank %}
          <ul class="footer-menu">

            {% for link in linklists[section.settings.company_links].links %}

              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>

            {% endfor %}

          </ul>
        {% endif %}

      </div>

      <!-- Contact -->

      <div class="footer-contact">

        <h3 class="footer-title">
          Contact
        </h3>

        <ul class="footer-contact-list">

          <li>

            <span class="footer-icon">📞</span>

            {{ section.settings.phone }}

          </li>

          <li>

            <span class="footer-icon">✉</span>

            {{ section.settings.email }}

          </li>

          <li>

            <span class="footer-icon">📍</span>

            {{ section.settings.address }}

          </li>

        </ul>

        <div class="footer-social">

          {% if settings.social_facebook_link != blank %}
            <a href="{{ settings.social_facebook_link }}">Facebook</a>
          {% endif %}

          {% if settings.social_instagram_link != blank %}
            <a href="{{ settings.social_instagram_link }}">Instagram</a>
          {% endif %}

          {% if settings.social_tiktok_link != blank %}
            <a href="{{ settings.social_tiktok_link }}">TikTok</a>
          {% endif %}

          {% if settings.social_youtube_link != blank %}
            <a href="{{ settings.social_youtube_link }}">YouTube</a>
          {% endif %}

        </div>

      </div>

    </div>

    <div class="footer-bottom">

      <p>

        {{ section.settings.copyright }}

      </p>

    </div>

  </div>

</footer>

{% schema %}
{
  "name": "ReadSphere Footer",
  "tag": "section",
  "class": "readsphere-footer",
  "settings": [

    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },

    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },

    {
      "type": "text",
      "id": "footer_heading",
      "label": "Footer Heading",
      "default": "ReadSphere"
    },

    {
      "type": "textarea",
      "id": "footer_description",
      "label": "Footer Description",
      "default": "Discover timeless fiction, inspiring non-fiction and bestselling books."
    },

    {
      "type": "link_list",
      "id": "quick_links",
      "label": "Your Account Menu"
    },

    {
      "type": "link_list",
      "id": "company_links",
      "label": "Company Menu"
    },

    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+92 300 1234567"
    },

    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "support@readsphere.pk"
    },

    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Karachi, Pakistan"
    },

    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© 2026 ReadSphere. All Rights Reserved."
    }

  ],

  "presets": [
    {
      "name": "ReadSphere Footer"
    }
  ]
}
{% endschema %}